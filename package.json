{
  "name": "web-admin-internal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "api:generate": "orval",
    "predev:mock": "msw init public --save",
    "dev:mock": "NEXT_PUBLIC_API_MOCKING=true next dev -p 3003",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "axios": "1.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query-devtools": "5.101.4",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "msw": "2.15.0",
    "orval": "8.24.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.30.3",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
